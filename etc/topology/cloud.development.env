# cloud.development - configure deployed development API URLs before use
SDKWORK_MALL_DEPLOYMENT_PROFILE=cloud
SDKWORK_MALL_ENVIRONMENT=development
SDKWORK_MALL_PROFILE_ID=cloud.development


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MALL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_MALL_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MALL_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
